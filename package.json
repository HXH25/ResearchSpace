{
  "name": "researchspace",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "ResearchSpace integrated local app with user AI and search providers",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:modules": "node scripts/check-modules.mjs",
    "check": "npm run check:modules && npm run check:source && npm run typecheck && npm run test && npm run build",
    "check:source": "node scripts/check-source.mjs",
    "server": "python run.py",
    "test:backend": "python -m pytest tests research_module/tests -q",
    "check:all": "npm run check && npm run test:backend",
    "test:e2e": "node tests/browser.cjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
