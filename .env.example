# Frontend build-time options. Never put API keys in VITE_* variables.
# Configure per-user AI/search API keys in the application's Settings tabs.
VITE_APP_MODE=live

# Reserved for a future community module; no public repository is guessed.
VITE_COMMUNITY_REPO=
VITE_COMMUNITY_REPO_ID=
VITE_COMMUNITY_CATEGORY=
VITE_COMMUNITY_CATEGORY_ID=
